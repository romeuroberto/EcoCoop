# PostgreSQL
POSTGRES_USER=ecocoop
POSTGRES_PASSWORD=ecocoop
POSTGRES_DB=ecocoop
# External port exposed to the host. Use 5433 to avoid conflicts with a local PostgreSQL on 5432.
POSTGRES_EXTERNAL_PORT=5433

# Backend env vars (mirrored in apps/backend/.env.example)
# Note: DATABASE_URL uses the internal Docker port (5432), not POSTGRES_EXTERNAL_PORT.
DATABASE_URL="postgresql://ecocoop:ecocoop@postgres:5432/ecocoop?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
BCRYPT_ROUNDS=10
API_PORT=3000
CORS_ORIGIN="http://localhost:5173"
