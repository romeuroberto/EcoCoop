# Database
DATABASE_URL="postgresql://ecocoop:ecocoop@localhost:5432/ecocoop?schema=public"

# JWT Secrets — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"

# bcrypt rounds (4–20, default 10)
BCRYPT_ROUNDS=10

# NestJS port (default 3000)
API_PORT=3000

# Frontend URL for CORS (default Vite dev server)
CORS_ORIGIN="http://localhost:5173"
