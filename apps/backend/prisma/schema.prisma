generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1 enums
enum ProfileType {
  ADMIN
  MANAGER
  SORTER
  DRIVER
  MEMBER
  BUYER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATE_CHANGE
}

// Used by CooperativeSettings; CostCenter entity added in Phase 5
enum ProfitSharingBase {
  NET_RESULT
  GROSS_REVENUE
  MANUAL
}

// Phase 5 enums — Rotas Recorrentes
enum TemplateStatus {
  ATIVO
  INATIVO
}

// Phase 2 enums
enum VehicleType {
  TRUCK
  VAN
  PICKUP
  MOTORCYCLE
  OTHER
}

enum DocumentType {
  CPF
  CNPJ
}

// Singleton — one record per instance
model Cooperative {
  id        String               @id @default(uuid())
  name      String
  cnpj      String               @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  createdAt DateTime             @default(now())
  settings  CooperativeSettings?
}

model CooperativeSettings {
  id                           String            @id @default(uuid())
  cooperativeId                String            @unique
  cooperative                  Cooperative       @relation(fields: [cooperativeId], references: [id])
  attendanceEnabled            Boolean           @default(false)
  rejectAlertDaysWithoutStatus Int               @default(30)
  defaultProfitSharingBase     ProfitSharingBase @default(NET_RESULT)
  occurrenceHorizonWeeks       Int               @default(4)
  updatedAt                    DateTime          @updatedAt
  // vehicleCostCenterId omitted — FK to CostCenter is Phase 5
}

model Profile {
  id          String              @id @default(uuid())
  name        String
  type        ProfileType
  isCustom    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  users       User[]
  permissions ProfilePermission[]
}

model ProfilePermission {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  module    String
  action    String

  @@unique([profileId, module, action])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id])
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs          AuditLog[]
  member             Member?                @relation("MemberUser")
  buyer              Buyer?                 @relation("BuyerUser")
  routesAsDriver     CollectionRoute[]      @relation("RouteDriver")
  routeTeamMembers   RouteTeamMember[]      @relation("RouteTeamMember")
  routeTemplates     RouteTemplate[]        @relation("TemplateDriver")
  rawMaterialEntries RawMaterialEntry[]     @relation("RawMaterialEntryUser")
  stockEvents        RawMaterialStockEvent[] @relation("StockEventUser")
}

model AuditLog {
  id            String      @id @default(uuid())
  entityType    String
  entityId      String
  action        AuditAction
  previousState Json?
  newState      Json?
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
}

// ─── Phase 2: Operational Base Data ─────────────────────────────────────────

model MemberRole {
  id        String   @id @default(uuid())
  name      String   @unique
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
}

model Member {
  id         String     @id @default(uuid())
  name       String
  cpf        String     @unique
  phone      String
  email      String?
  admittedAt DateTime
  roleId     String
  role       MemberRole @relation(fields: [roleId], references: [id])
  isActive   Boolean    @default(true)
  notes      String?
  userId     String?    @unique
  user       User?      @relation("MemberUser", fields: [userId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([isActive])
  @@index([roleId])
}

model MaterialCategory {
  id            String                @id @default(uuid())
  name          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  subcategories MaterialSubcategory[]
}

model MaterialSubcategory {
  id            String           @id @default(uuid())
  categoryId    String
  category      MaterialCategory @relation(fields: [categoryId], references: [id])
  name          String
  defaultUnitId String
  defaultUnit   UnitOfMeasure    @relation("SubcategoryDefaultUnit", fields: [defaultUnitId], references: [id])
  isSellable    Boolean          @default(false)
  acceptsStock  Boolean          @default(false)
  notes         String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rawMaterialEntries   RawMaterialEntry[]     @relation("RawMaterialEntrySubcategory")
  stockEvents          RawMaterialStockEvent[] @relation("StockEventSubcategory")

  @@unique([categoryId, name])
  @@index([categoryId, isActive])
}

model UnitOfMeasure {
  id               String                @id @default(uuid())
  name             String                @unique
  symbol           String                @unique
  baseUnitId       String?
  baseUnit         UnitOfMeasure?        @relation("UnitConversion", fields: [baseUnitId], references: [id])
  derivedUnits     UnitOfMeasure[]       @relation("UnitConversion")
  conversionFactor Decimal?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  subcategories    MaterialSubcategory[]  @relation("SubcategoryDefaultUnit")
  vehicles         Vehicle[]              @relation("VehicleCapacityUnit")
  rawMaterialEntries   RawMaterialEntry[]     @relation("RawMaterialEntryUnit")
  stockEvents          RawMaterialStockEvent[] @relation("StockEventUnit")
}

model Buyer {
  id                String       @id @default(uuid())
  legalName         String
  documentType      DocumentType
  documentNumber    String       @unique
  phone             String?
  email             String?
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressCity       String?
  addressState      String?
  addressZip        String?
  notes             String?
  isActive          Boolean      @default(true)
  userId            String?      @unique
  user              User?        @relation("BuyerUser", fields: [userId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([isActive])
}

model Vehicle {
  id             String         @id @default(uuid())
  plate          String         @unique
  type           VehicleType
  model          String
  capacityValue  Decimal?
  capacityUnitId String?
  capacityUnit   UnitOfMeasure? @relation("VehicleCapacityUnit", fields: [capacityUnitId], references: [id])
  capacityNotes  String?
  isActive       Boolean          @default(true)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  collectionRoutes CollectionRoute[]
  routeTemplates   RouteTemplate[]  @relation("TemplateVehicle")
}

model EpiType {
  id                  String   @id @default(uuid())
  name                String   @unique
  defaultValidityDays Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CostCenter {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Phase 5: Route Templates (Rotas Recorrentes) ────────────────────────────

model RouteTemplate {
  id             String         @id @default(uuid())
  name           String
  recurrenceDays Int[]
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  driverId       String
  driver         User           @relation("TemplateDriver", fields: [driverId], references: [id])
  vehicleId      String
  vehicle        Vehicle        @relation("TemplateVehicle", fields: [vehicleId], references: [id])
  status         TemplateStatus @default(ATIVO)
  notes          String?
  version        Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  templatePoints RouteTemplatePoint[]
  occurrences    CollectionRoute[]

  @@index([status])
}

model RouteTemplatePoint {
  id                String          @id @default(uuid())
  templateId        String
  template          RouteTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  sequence          Int
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([templateId, collectionPointId])
  @@unique([templateId, sequence])
  @@index([templateId, sequence])
}

// ─── Phase 3: Collection Routes & Raw Material ────────────────────────────────

enum RouteStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum RawMaterialStockEventType {
  ENTRADA_BRUTO
  ESTORNO_BRUTO
}

model CollectionPoint {
  id              String       @id @default(uuid())
  name            String
  address         String
  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)
  locationPending Boolean      @default(true)
  reference       String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  routePoints          RoutePoint[]
  routeTemplatePoints  RouteTemplatePoint[]

  @@index([isActive])
  @@index([name])
}

model CollectionRoute {
  id          String      @id @default(uuid())
  name        String
  plannedDate DateTime    @db.Date
  status      RouteStatus @default(PLANEJADA)
  startedAt   DateTime?
  completedAt DateTime?
  cancelReason String?
  vehicleId   String
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id])
  driverId    String
  driver      User        @relation("RouteDriver", fields: [driverId], references: [id])
  notes       String?
  version     Int         @default(0)
  templateId  String?
  template    RouteTemplate? @relation(fields: [templateId], references: [id])
  isException Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  routePoints     RoutePoint[]
  teamMembers     RouteTeamMember[]
  materialEntries RawMaterialEntry[]

  @@unique([templateId, plannedDate])
  @@index([status])
  @@index([driverId])
  @@index([plannedDate])
  @@index([templateId])
}

model RoutePoint {
  id                String          @id @default(uuid())
  routeId           String
  route             CollectionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  sequence          Int
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([routeId, collectionPointId])
  @@unique([routeId, sequence])
  @@index([routeId, sequence])
}

model RouteTeamMember {
  id      String          @id @default(uuid())
  routeId String
  route   CollectionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  userId  String
  user    User            @relation("RouteTeamMember", fields: [userId], references: [id])
  addedAt DateTime        @default(now())

  @@unique([routeId, userId])
  @@index([routeId])
}

model RawMaterialEntry {
  id            String              @id @default(uuid())
  routeId       String
  route         CollectionRoute     @relation(fields: [routeId], references: [id])
  subcategoryId String
  subcategory   MaterialSubcategory @relation("RawMaterialEntrySubcategory", fields: [subcategoryId], references: [id])
  quantity      Decimal             @db.Decimal(12, 3)
  unitId        String
  unit          UnitOfMeasure       @relation("RawMaterialEntryUnit", fields: [unitId], references: [id])
  notes         String?
  userId        String
  user          User                @relation("RawMaterialEntryUser", fields: [userId], references: [id])
  createdAt     DateTime            @default(now())

  stockEvent RawMaterialStockEvent?

  @@index([routeId])
  @@index([subcategoryId, unitId])
}

model RawMaterialStockEvent {
  id                 String                    @id @default(uuid())
  type               RawMaterialStockEventType
  subcategoryId      String
  subcategory        MaterialSubcategory       @relation("StockEventSubcategory", fields: [subcategoryId], references: [id])
  unitId             String
  unit               UnitOfMeasure             @relation("StockEventUnit", fields: [unitId], references: [id])
  quantity           Decimal                   @db.Decimal(12, 3)
  rawMaterialEntryId String?                   @unique
  rawMaterialEntry   RawMaterialEntry?         @relation(fields: [rawMaterialEntryId], references: [id])
  referencedEventId  String?
  referencedEvent    RawMaterialStockEvent?    @relation("EventReversal", fields: [referencedEventId], references: [id])
  reversals          RawMaterialStockEvent[]   @relation("EventReversal")
  justification      String?
  userId             String
  user               User                      @relation("StockEventUser", fields: [userId], references: [id])
  createdAt          DateTime                  @default(now())

  @@index([subcategoryId, unitId])
  @@index([type])
  @@index([rawMaterialEntryId])
  @@unique([referencedEventId])
}
