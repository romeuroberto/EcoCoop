generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1 enums
enum ProfileType {
  ADMIN
  MANAGER
  SORTER
  DRIVER
  MEMBER
  BUYER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATE_CHANGE
}

// Used by CooperativeSettings; CostCenter entity added in Phase 5
enum ProfitSharingBase {
  NET_RESULT
  GROSS_REVENUE
  MANUAL
}

// Phase 5 enums — Rotas Recorrentes
enum TemplateStatus {
  ATIVO
  INATIVO
}

// Phase 2 enums
enum VehicleType {
  TRUCK
  VAN
  PICKUP
  MOTORCYCLE
  OTHER
}

enum DocumentType {
  CPF
  CNPJ
}

// Singleton — one record per instance
model Cooperative {
  id        String               @id @default(uuid())
  name      String
  cnpj      String               @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  createdAt DateTime             @default(now())
  settings  CooperativeSettings?
}

model CooperativeSettings {
  id                           String            @id @default(uuid())
  cooperativeId                String            @unique
  cooperative                  Cooperative       @relation(fields: [cooperativeId], references: [id])
  attendanceEnabled            Boolean           @default(false)
  rejectAlertDaysWithoutStatus Int               @default(30)
  defaultProfitSharingBase     ProfitSharingBase @default(NET_RESULT)
  occurrenceHorizonWeeks       Int               @default(4)
  updatedAt                    DateTime          @updatedAt
  // vehicleCostCenterId omitted — FK to CostCenter is Phase 5
}

model Profile {
  id          String              @id @default(uuid())
  name        String
  type        ProfileType
  isCustom    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  users       User[]
  permissions ProfilePermission[]
}

model ProfilePermission {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  module    String
  action    String

  @@unique([profileId, module, action])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id])
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs          AuditLog[]
  member             Member?                @relation("MemberUser")
  buyer              Buyer?                 @relation("BuyerUser")
  routesAsDriver     CollectionRoute[]      @relation("RouteDriver")
  routeTeamMembers   RouteTeamMember[]      @relation("RouteTeamMember")
  routeTemplates     RouteTemplate[]        @relation("TemplateDriver")
  rawMaterialEntries    RawMaterialEntry[]      @relation("RawMaterialEntryUser")
  stockEvents           RawMaterialStockEvent[] @relation("StockEventUser")
  sortingOperations     SortingOperation[]      @relation("SortingOperationUser")
  sortingCancellations  SortingOperation[]      @relation("SortingCancelledBy")
  readyStockEvents      ReadyStockEvent[]       @relation("ReadyStockEventUser")
  readyStockAdjustments ReadyStockAdjustment[]  @relation("ReadyStockAdjustmentUser")
  salesCreated          Sale[]                  @relation("SaleCreatedBy")
  salesDelivered        Sale[]                  @relation("SaleDeliveredBy")
  salesCancelled        Sale[]                  @relation("SaleCancelledBy")
}

model AuditLog {
  id            String      @id @default(uuid())
  entityType    String
  entityId      String
  action        AuditAction
  previousState Json?
  newState      Json?
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
}

// ─── Phase 2: Operational Base Data ─────────────────────────────────────────

model MemberRole {
  id        String   @id @default(uuid())
  name      String   @unique
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
}

model Member {
  id         String     @id @default(uuid())
  name       String
  cpf        String     @unique
  phone      String
  email      String?
  admittedAt DateTime
  roleId     String
  role       MemberRole @relation(fields: [roleId], references: [id])
  isActive   Boolean    @default(true)
  notes      String?
  userId     String?    @unique
  user       User?      @relation("MemberUser", fields: [userId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([isActive])
  @@index([roleId])
}

model MaterialCategory {
  id            String                @id @default(uuid())
  name          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  subcategories MaterialSubcategory[]
}

model MaterialSubcategory {
  id            String           @id @default(uuid())
  categoryId    String
  category      MaterialCategory @relation(fields: [categoryId], references: [id])
  name          String
  defaultUnitId String
  defaultUnit   UnitOfMeasure    @relation("SubcategoryDefaultUnit", fields: [defaultUnitId], references: [id])
  isSellable    Boolean          @default(false)
  acceptsStock  Boolean          @default(false)
  notes         String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rawMaterialEntries    RawMaterialEntry[]      @relation("RawMaterialEntrySubcategory")
  stockEvents           RawMaterialStockEvent[] @relation("StockEventSubcategory")
  sortingOperations     SortingOperation[]      @relation("SortingOpSubcategory")
  sortingOutputs        SortingOutput[]         @relation("SortingOutputSubcategory")
  sortingRejects        SortingReject[]         @relation("SortingRejectSubcategory")
  readyStockEvents      ReadyStockEvent[]       @relation("ReadyStockEventSubcategory")
  readyStockAdjustments ReadyStockAdjustment[]  @relation("ReadyStockAdjustmentSubcategory")
  saleItems             SaleItem[]              @relation("SaleItemSubcategory")

  @@unique([categoryId, name])
  @@index([categoryId, isActive])
}

model UnitOfMeasure {
  id               String                @id @default(uuid())
  name             String                @unique
  symbol           String                @unique
  baseUnitId       String?
  baseUnit         UnitOfMeasure?        @relation("UnitConversion", fields: [baseUnitId], references: [id])
  derivedUnits     UnitOfMeasure[]       @relation("UnitConversion")
  conversionFactor Decimal?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  subcategories    MaterialSubcategory[]  @relation("SubcategoryDefaultUnit")
  vehicles         Vehicle[]              @relation("VehicleCapacityUnit")
  rawMaterialEntries    RawMaterialEntry[]      @relation("RawMaterialEntryUnit")
  stockEvents           RawMaterialStockEvent[] @relation("StockEventUnit")
  sortingOperations     SortingOperation[]      @relation("SortingOpUnit")
  sortingOutputs        SortingOutput[]         @relation("SortingOutputUnit")
  sortingRejects        SortingReject[]         @relation("SortingRejectUnit")
  readyStockEvents      ReadyStockEvent[]       @relation("ReadyStockEventUnit")
  readyStockAdjustments ReadyStockAdjustment[]  @relation("ReadyStockAdjustmentUnit")
  saleItems             SaleItem[]              @relation("SaleItemUnit")
}

model Buyer {
  id                String       @id @default(uuid())
  legalName         String
  documentType      DocumentType
  documentNumber    String       @unique
  phone             String?
  email             String?
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressCity       String?
  addressState      String?
  addressZip        String?
  notes             String?
  isActive          Boolean      @default(true)
  userId            String?      @unique
  user              User?        @relation("BuyerUser", fields: [userId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  sales             Sale[]
  accountsReceivable AccountReceivable[] @relation("BuyerReceivables")

  @@index([isActive])
}

model Vehicle {
  id             String         @id @default(uuid())
  plate          String         @unique
  type           VehicleType
  model          String
  capacityValue  Decimal?
  capacityUnitId String?
  capacityUnit   UnitOfMeasure? @relation("VehicleCapacityUnit", fields: [capacityUnitId], references: [id])
  capacityNotes  String?
  isActive       Boolean          @default(true)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  collectionRoutes CollectionRoute[]
  routeTemplates   RouteTemplate[]  @relation("TemplateVehicle")
}

model EpiType {
  id                  String   @id @default(uuid())
  name                String   @unique
  defaultValidityDays Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CostCenter {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Phase 5: Route Templates (Rotas Recorrentes) ────────────────────────────

model RouteTemplate {
  id             String         @id @default(uuid())
  name           String
  recurrenceDays Int[]
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  driverId       String
  driver         User           @relation("TemplateDriver", fields: [driverId], references: [id])
  vehicleId      String
  vehicle        Vehicle        @relation("TemplateVehicle", fields: [vehicleId], references: [id])
  status         TemplateStatus @default(ATIVO)
  notes          String?
  version        Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  templatePoints RouteTemplatePoint[]
  occurrences    CollectionRoute[]

  @@index([status])
}

model RouteTemplatePoint {
  id                String          @id @default(uuid())
  templateId        String
  template          RouteTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  sequence          Int
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([templateId, collectionPointId])
  @@unique([templateId, sequence])
  @@index([templateId, sequence])
}

// ─── Phase 3: Collection Routes & Raw Material ────────────────────────────────

enum RouteStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum RawMaterialStockEventType {
  ENTRADA_BRUTO
  ESTORNO_BRUTO
  SAIDA_TRIAGEM
  ESTORNO_TRIAGEM
}

enum SortingOperationStatus {
  CONCLUIDA
  CANCELADA
}

enum SortingRejectType {
  REJEITO
  PERDA
  PERDA_INERENTE
}

enum ReadyStockEventType {
  TRIAGEM_OUTPUT
  AJUSTE
  ESTORNO
  VENDA
  ESTORNO_VENDA
}

enum SaleStatus {
  PENDENTE_ENTREGA
  ENTREGUE
  CANCELADA
}

enum AccountReceivableStatus {
  A_RECEBER
  CANCELADA
}

model CollectionPoint {
  id              String       @id @default(uuid())
  name            String
  address         String
  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)
  locationPending Boolean      @default(true)
  reference       String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  routePoints          RoutePoint[]
  routeTemplatePoints  RouteTemplatePoint[]

  @@index([isActive])
  @@index([name])
}

model CollectionRoute {
  id          String      @id @default(uuid())
  name        String
  plannedDate DateTime    @db.Date
  status      RouteStatus @default(PLANEJADA)
  startedAt   DateTime?
  completedAt DateTime?
  cancelReason String?
  vehicleId   String
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id])
  driverId    String
  driver      User        @relation("RouteDriver", fields: [driverId], references: [id])
  notes       String?
  version     Int         @default(0)
  templateId  String?
  template    RouteTemplate? @relation(fields: [templateId], references: [id])
  isException Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  routePoints     RoutePoint[]
  teamMembers     RouteTeamMember[]
  materialEntries RawMaterialEntry[]

  @@unique([templateId, plannedDate])
  @@index([status])
  @@index([driverId])
  @@index([plannedDate])
  @@index([templateId])
}

model RoutePoint {
  id                String          @id @default(uuid())
  routeId           String
  route             CollectionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  collectionPointId String
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  sequence          Int
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([routeId, collectionPointId])
  @@unique([routeId, sequence])
  @@index([routeId, sequence])
}

model RouteTeamMember {
  id      String          @id @default(uuid())
  routeId String
  route   CollectionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  userId  String
  user    User            @relation("RouteTeamMember", fields: [userId], references: [id])
  addedAt DateTime        @default(now())

  @@unique([routeId, userId])
  @@index([routeId])
}

model RawMaterialEntry {
  id            String              @id @default(uuid())
  routeId       String
  route         CollectionRoute     @relation(fields: [routeId], references: [id])
  subcategoryId String
  subcategory   MaterialSubcategory @relation("RawMaterialEntrySubcategory", fields: [subcategoryId], references: [id])
  quantity      Decimal             @db.Decimal(12, 3)
  unitId        String
  unit          UnitOfMeasure       @relation("RawMaterialEntryUnit", fields: [unitId], references: [id])
  notes         String?
  userId        String
  user          User                @relation("RawMaterialEntryUser", fields: [userId], references: [id])
  createdAt     DateTime            @default(now())

  stockEvent RawMaterialStockEvent?

  @@index([routeId])
  @@index([subcategoryId, unitId])
}

model RawMaterialStockEvent {
  id                 String                    @id @default(uuid())
  type               RawMaterialStockEventType
  subcategoryId      String
  subcategory        MaterialSubcategory       @relation("StockEventSubcategory", fields: [subcategoryId], references: [id])
  unitId             String
  unit               UnitOfMeasure             @relation("StockEventUnit", fields: [unitId], references: [id])
  quantity           Decimal                   @db.Decimal(12, 3)
  rawMaterialEntryId String?                   @unique
  rawMaterialEntry   RawMaterialEntry?         @relation(fields: [rawMaterialEntryId], references: [id])
  referencedEventId  String?
  referencedEvent    RawMaterialStockEvent?    @relation("EventReversal", fields: [referencedEventId], references: [id])
  reversals          RawMaterialStockEvent[]   @relation("EventReversal")
  justification      String?
  sortingOperationId String?
  sortingOperation   SortingOperation?         @relation("BrutoSortingEvents", fields: [sortingOperationId], references: [id])
  userId             String
  user               User                      @relation("StockEventUser", fields: [userId], references: [id])
  createdAt          DateTime                  @default(now())

  @@index([subcategoryId, unitId])
  @@index([type])
  @@index([rawMaterialEntryId])
  @@index([sortingOperationId])
  @@unique([referencedEventId])
}

// ─── Feature 006: Triagem e Estoque Pronto ───────────────────────────────────

model SortingOperation {
  id                String                 @id @default(uuid())
  subcategoryId     String
  subcategory       MaterialSubcategory    @relation("SortingOpSubcategory", fields: [subcategoryId], references: [id])
  unitId            String
  unit              UnitOfMeasure          @relation("SortingOpUnit", fields: [unitId], references: [id])
  processedQuantity Decimal                @db.Decimal(12, 3)
  status            SortingOperationStatus @default(CONCLUIDA)
  cancelReason      String?
  cancelledById     String?
  cancelledBy       User?                  @relation("SortingCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt       DateTime?
  userId            String
  user              User                   @relation("SortingOperationUser", fields: [userId], references: [id])
  createdAt         DateTime               @default(now())

  outputs          SortingOutput[]
  rejects          SortingReject[]
  rawStockEvents   RawMaterialStockEvent[] @relation("BrutoSortingEvents")
  readyStockEvents ReadyStockEvent[]       @relation("SortingOpReadyEvents")

  @@index([subcategoryId, unitId])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model SortingOutput {
  id                 String              @id @default(uuid())
  sortingOperationId String
  sortingOperation   SortingOperation    @relation(fields: [sortingOperationId], references: [id], onDelete: Cascade)
  subcategoryId      String
  subcategory        MaterialSubcategory @relation("SortingOutputSubcategory", fields: [subcategoryId], references: [id])
  unitId             String
  unit               UnitOfMeasure       @relation("SortingOutputUnit", fields: [unitId], references: [id])
  quantity           Decimal             @db.Decimal(12, 3)
  createdAt          DateTime            @default(now())

  readyStockEvent ReadyStockEvent? @relation("OutputReadyEvent")

  @@index([sortingOperationId])
  @@index([subcategoryId, unitId])
}

model SortingReject {
  id                 String               @id @default(uuid())
  sortingOperationId String
  sortingOperation   SortingOperation     @relation(fields: [sortingOperationId], references: [id], onDelete: Cascade)
  type               SortingRejectType
  subcategoryId      String?
  subcategory        MaterialSubcategory? @relation("SortingRejectSubcategory", fields: [subcategoryId], references: [id])
  unitId             String
  unit               UnitOfMeasure        @relation("SortingRejectUnit", fields: [unitId], references: [id])
  quantity           Decimal              @db.Decimal(12, 3)
  description        String?

  @@index([sortingOperationId])
}

model ReadyStockEvent {
  id                 String               @id @default(uuid())
  type               ReadyStockEventType
  subcategoryId      String
  subcategory        MaterialSubcategory  @relation("ReadyStockEventSubcategory", fields: [subcategoryId], references: [id])
  unitId             String
  unit               UnitOfMeasure        @relation("ReadyStockEventUnit", fields: [unitId], references: [id])
  quantity           Decimal              @db.Decimal(12, 3)
  sortingOperationId String?
  sortingOperation   SortingOperation?   @relation("SortingOpReadyEvents", fields: [sortingOperationId], references: [id])
  sortingOutputId    String?              @unique
  sortingOutput      SortingOutput?       @relation("OutputReadyEvent", fields: [sortingOutputId], references: [id])
  adjustmentId       String?              @unique
  adjustment         ReadyStockAdjustment? @relation(fields: [adjustmentId], references: [id])
  saleId             String?
  sale               Sale?                @relation("SaleReadyEvents", fields: [saleId], references: [id])
  saleItemId         String?              @unique
  saleItem           SaleItem?            @relation("SaleItemReadyEvent", fields: [saleItemId], references: [id])
  userId             String
  user               User                 @relation("ReadyStockEventUser", fields: [userId], references: [id])
  createdAt          DateTime             @default(now())

  @@index([subcategoryId, unitId])
  @@index([type])
  @@index([sortingOperationId])
  @@index([saleId])
  @@index([createdAt])
}

model ReadyStockAdjustment {
  id            String              @id @default(uuid())
  subcategoryId String
  subcategory   MaterialSubcategory @relation("ReadyStockAdjustmentSubcategory", fields: [subcategoryId], references: [id])
  unitId        String
  unit          UnitOfMeasure       @relation("ReadyStockAdjustmentUnit", fields: [unitId], references: [id])
  quantity      Decimal             @db.Decimal(12, 3)
  justification String
  userId        String
  user          User                @relation("ReadyStockAdjustmentUser", fields: [userId], references: [id])
  createdAt     DateTime            @default(now())

  stockEvent ReadyStockEvent?

  @@index([subcategoryId, unitId])
  @@index([userId])
  @@index([createdAt])
}

// ─── Feature 007: Vendas Operacionais ───────────────────────────────────────

model Sale {
  id            String     @id @default(uuid())
  buyerId       String
  buyer         Buyer      @relation(fields: [buyerId], references: [id])
  status        SaleStatus @default(PENDENTE_ENTREGA)
  totalAmount   Decimal    @db.Decimal(14, 2)
  notes         String?
  deliveredAt   DateTime?
  deliveredById String?
  deliveredBy   User?      @relation("SaleDeliveredBy", fields: [deliveredById], references: [id])
  cancelReason  String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?      @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  userId        String
  user          User       @relation("SaleCreatedBy", fields: [userId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items             SaleItem[]
  readyStockEvents  ReadyStockEvent[]   @relation("SaleReadyEvents")
  accountReceivable AccountReceivable?

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model SaleItem {
  id            String              @id @default(uuid())
  saleId        String
  sale          Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  subcategoryId String
  subcategory   MaterialSubcategory @relation("SaleItemSubcategory", fields: [subcategoryId], references: [id])
  unitId        String
  unit          UnitOfMeasure       @relation("SaleItemUnit", fields: [unitId], references: [id])
  quantity      Decimal             @db.Decimal(12, 3)
  unitPrice     Decimal             @db.Decimal(14, 4)
  subtotal      Decimal             @db.Decimal(14, 2)
  createdAt     DateTime            @default(now())

  readyStockEvent ReadyStockEvent? @relation("SaleItemReadyEvent")

  @@index([saleId])
  @@index([subcategoryId, unitId])
}

model AccountReceivable {
  id        String                  @id @default(uuid())
  saleId    String                  @unique
  sale      Sale                    @relation(fields: [saleId], references: [id])
  buyerId   String
  buyer     Buyer                   @relation("BuyerReceivables", fields: [buyerId], references: [id])
  amount    Decimal                 @db.Decimal(14, 2)
  dueDate   DateTime                @db.Date
  status    AccountReceivableStatus @default(A_RECEBER)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([buyerId])
  @@index([status])
  @@index([dueDate])
}
